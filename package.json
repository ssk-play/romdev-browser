{
  "name": "romdev-browser",
  "version": "0.5.2",
  "description": "Run romdev's toolchains (SDCC for Game Boy / Game Boy Color, cc65 for NES) and emulator cores (gambatte, fceumm) in the browser, inside Web Workers with a postMessage protocol, and headless over HTTP.",
  "license": "GPL-2.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssk-play/romdev-browser.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "romdev-core-fceumm": "file:../romdev/packages/romdev-core-fceumm",
    "romdev-core-gambatte": "file:../romdev/packages/romdev-core-gambatte",
    "romdev-core-host": "file:../romdev/packages/romdev-core-host",
    "romdev-toolchain-cc65": "file:../romdev/packages/romdev-toolchain-cc65",
    "romdev-toolchain-sdcc": "file:../romdev/packages/romdev-toolchain-sdcc"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
